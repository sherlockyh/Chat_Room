NODE_ENV=development
PORT=3000
WEB_ORIGIN=http://localhost:5173
# 密码含特殊字符时，DATABASE_URL 和 REDIS_URL 中的密码需 URL 编码。
DATABASE_URL=mysql://chat:change-me-chat-password@localhost:3306/chat_room
REDIS_URL=redis://:change-me-redis-password@localhost:6379
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=chatminio
MINIO_SECRET_KEY=change-me-minio-password
MINIO_BUCKET=chat-room
